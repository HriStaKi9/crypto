# Копирай на .env и попълни. Никога не commit-вай .env.

# --- PostgreSQL / TimescaleDB ---
POSTGRES_USER=mse
POSTGRES_PASSWORD=change_me
POSTGRES_DB=market_signal_engine
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://mse:change_me@localhost:5432/market_signal_engine

# --- Adminer (db admin UI) ---
ADMINER_PORT=8081

# --- Ingestion monitoring dashboard (api/main.py) ---
API_PORT=8000

# --- Новини ---
GDELT_BASE_URL=https://api.gdeltproject.org/api/v2
CRYPTOPANIC_API_KEY=
CRYPTOPANIC_BASE_URL=https://cryptopanic.com/api/v1
RSS_COINDESK_URL=https://www.coindesk.com/arc/outboundfeeds/rss/
RSS_THEBLOCK_URL=https://www.theblock.co/rss.xml
# Общи пазарни RSS (не крипто-специфични) — override-вай ако конкретен
# URL умре или намериш по-надежден feed за същия издател. Reuters няма
# работещ публичен RSS (проверено 2026-09-19, виж ingestion/rss_feeds.py) —
# затова няма RSS_REUTERS_URL тук.
RSS_MARKETWATCH_URL=https://feeds.content.dowjones.io/public/rss/mw_topstories
RSS_INVESTING_URL=https://www.investing.com/rss/news_25.rss

# --- Крипто цени ---
BINANCE_BASE_URL=https://api.binance.com
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# --- Акции ---
FINNHUB_API_KEY=

# --- NLP / модели ---
HF_HOME=./.cache/huggingface
FINBERT_MODEL=ProsusAI/finbert
CRYPTOBERT_MODEL=ElKulako/cryptobert

# --- Приложение ---
APP_ENV=development
LOG_LEVEL=INFO
TZ=UTC
